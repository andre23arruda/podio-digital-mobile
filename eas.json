      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_ROUTE": "https://EXPO_PUBLIC_API_ROUTE"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_ROUTE": "https://EXPO_PUBLIC_API_ROUTE"
      }
    }
  }
}